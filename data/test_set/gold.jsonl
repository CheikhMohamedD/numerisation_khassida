{"path": "page-01/line-0001.png", "page": 1, "index": 1, "text": "أَعُوذُ بِاللهِ مِنَ الشَّيْطَانِ الرَّجِيمِ"}
{"path": "page-01/line-0002.png", "page": 1, "index": 2, "text": "وَإِنِّي أُعِيذُهَا بِكَ وَذُرِّيَّتَهَا مِنَ"}
{"path": "page-01/line-0003.png", "page": 1, "index": 3, "text": "الشَّيْطَانِ الرَّجِيمِ رَبِّ أَعُوذُ بِكَ مِنْ"}
{"path": "page-01/line-0004.png", "page": 1, "index": 4, "text": "هَمَزَاتِ الشَّيَاطِينِ وَأَعُوذُ بِكَ رَبِّ أَنْ يَحْضُرُونِ"}
{"path": "page-01/line-0005.png", "page": 1, "index": 5, "text": "بِسْمِ اللهِ الرَّحْمَنِ الرَّحِيمِ"}
{"path": "page-01/line-0006.png", "page": 1, "index": 6, "text": "اللهُمَّ بِحَقِّ وَجْهِكَ الْكَرِيمِ صَلِّ"}
{"path": "page-01/line-0007.png", "page": 1, "index": 7, "text": "وَسَلِّمْ وَبَارِكْ عَلَى سَيِّدِنَا وَمَوْلَانَا"}
{"path": "page-01/line-0008.png", "page": 1, "index": 8, "text": "مُحَمَّدٍ وَآلِهِ وَصَحْبِهِ يَا مَنْ جَعَلَ"}
{"path": "page-01/line-0009.png", "page": 1, "index": 9, "text": "هَذِهِ الْحُرُوفَ رِضَاكَ وَرِضَى"}
{"path": "page-01/line-0010.png", "page": 1, "index": 10, "text": "رَسُولِكَ عَلَيْهِ الصَّلَاةُ وَالسَّلَامُ"}
